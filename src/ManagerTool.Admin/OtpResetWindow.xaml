<Window x:Class="ManagerTool.Admin.OtpResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Tool — Reset password" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1B1B1B">
    <StackPanel Margin="18">
        <TextBlock Text="Enter your code" FontSize="14" FontWeight="Bold" Foreground="#EEE" />
        <TextBlock x:Name="Intro" Foreground="#999" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0" />

        <TextBlock Text="Reset code" Foreground="#BBB" FontSize="11.5" Margin="0,14,0,4" />
        <TextBox x:Name="CodeBox" Height="34" MaxLength="6" FontFamily="Consolas" FontSize="18"
                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                 TextChanged="Validate" />

        <TextBlock Text="New password (min 8)" Foreground="#BBB" FontSize="11.5" Margin="0,12,0,4" />
        <PasswordBox x:Name="NewBox" Height="28" VerticalContentAlignment="Center" PasswordChanged="Validate" />

        <TextBlock Text="Confirm new password" Foreground="#BBB" FontSize="11.5" Margin="0,10,0,4" />
        <PasswordBox x:Name="ConfirmBox" Height="28" VerticalContentAlignment="Center" PasswordChanged="Validate" />

        <TextBlock x:Name="Message" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ResendButton" Content="Send a new code" Height="28" Padding="10,0"
                    Click="Resend_Click" />
            <Button Content="Cancel" Width="72" Height="28" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="SubmitButton" Content="Set password" Height="28" Padding="14,0" Margin="8,0,0,0"
                    Click="Submit_Click" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
