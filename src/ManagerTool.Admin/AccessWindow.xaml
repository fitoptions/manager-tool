<Window x:Class="ManagerTool.Admin.AccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Tool — Workstation access" Height="640" Width="720"
        WindowStartupLocation="CenterOwner" Background="#1B1B1B">
    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Viewers &amp; workstation access" FontWeight="Bold" FontSize="15" Foreground="#EEE" />
            <TextBlock Foreground="#999" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"
                       Text="Every viewer sees all PCs by default, including ones enrolled later. Untick a PC to block it for that viewer — a blocked PC vanishes from their workstation list, live screen, activity history, reports, recordings and alerts. Changes save immediately." />

            <!-- Lockout queue: present only when somebody is actually waiting. -->
            <Border x:Name="ResetQueuePanel" Background="#2A2318" BorderBrush="#4A3A1A" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Locked-out viewers" FontWeight="Bold" Foreground="#D7A53E" FontSize="12" />
                    <TextBlock Foreground="#A89060" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,7"
                               Text="These accounts reported being locked out. Anyone can send one of these, so confirm it really came from the person before setting a new password." />
                    <ItemsControl x:Name="ResetQueueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#EEE"
                                               VerticalAlignment="Center" MinWidth="110" />
                                    <TextBlock Text="{Binding When}" Foreground="#888" FontSize="10.5"
                                               VerticalAlignment="Center" MinWidth="140" />
                                    <Button Content="Set password" Height="24" Padding="9,0" FontSize="11"
                                            Click="SetResetPassword_Click" />
                                    <Button Content="Dismiss" Height="24" Padding="9,0" FontSize="11" Margin="5,0,0,0"
                                            Click="DismissReset_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Issue a viewer sign-in" FontWeight="Bold" Foreground="#DDD" FontSize="12" />
                    <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,7"
                               Text="Works immediately — no approval step. Hand the password over yourself; they can change it once signed in." />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NewUserBox" Width="150" Height="27" VerticalContentAlignment="Center"
                                 ToolTip="Username for the new viewer" />
                        <TextBox x:Name="NewPassBox" Width="190" Height="27" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center" FontFamily="Consolas"
                                 ToolTip="Password (min 8 characters)" />
                        <Button Content="⟳" Width="30" Height="27" Margin="4,0,0,0"
                                Click="GeneratePassword_Click" ToolTip="Generate a strong password" />
                        <Button Content="Create viewer" Height="27" Padding="12,0" Margin="6,0,0,0"
                                Click="CreateViewer_Click" />
                    </StackPanel>
                    <TextBlock x:Name="CreateMessage" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="#888" FontSize="11.5" VerticalAlignment="Center" />
                <Button Content="Close" Width="80" Height="27" HorizontalAlignment="Right" Click="CloseButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="EmptyText" Foreground="#888" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" VerticalAlignment="Top" />

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ViewerList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#EEE" FontSize="13" />
                                    <Border Background="#3A3018" BorderBrush="#4A3A1A" BorderThickness="1"
                                            CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Visibility="{Binding PendingVisibility}">
                                        <TextBlock Text="PENDING" FontSize="9.5" FontWeight="Bold" Foreground="#D7A53E" />
                                    </Border>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Hosts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Allowed, Mode=TwoWay}"
                                                      Foreground="#DDD" Margin="0,3,18,3"
                                                      ToolTip="{Binding Tooltip}"
                                                      Checked="HostCheck_Changed" Unchecked="HostCheck_Changed">
                                                <TextBlock>
                                                    <Run Text="{Binding StatusDot, Mode=OneWay}" Foreground="{Binding StatusBrush}" />
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Summary}" Foreground="#888" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
