<Window x:Class="ManagerTool.Admin.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Tool — Alerts" Height="560" Width="900"
        WindowStartupLocation="CenterOwner" Background="#1B1B1B">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Compliance Alerts" FontWeight="Bold" FontSize="15" Foreground="#EEE"
                       VerticalAlignment="Center" />
            <CheckBox x:Name="UnackOnly" Content="Unacknowledged only" Foreground="#CCC"
                      VerticalAlignment="Center" Margin="18,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <Button Content="Refresh" Width="72" Height="26" Margin="14,0,0,0" Click="Refresh_Click" />
            <TextBlock x:Name="CountText" Foreground="#888" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                  Foreground="#EEE" Background="#1B1B1B" BorderBrush="#3A3A3A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding LocalTime}" Width="150" />
                <DataGridTemplateColumn Header="Severity" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,1" Margin="2" HorizontalAlignment="Left"
                                    Background="{Binding SeverityBrush}">
                                <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Workstation" Binding="{Binding Machine}" Width="140" />
                <DataGridTextColumn Header="What happened" Binding="{Binding Message}" Width="*" />
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding AckLabel}" IsEnabled="{Binding CanAck}"
                                    Tag="{Binding Id}" Click="Ack_Click" Height="24" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
