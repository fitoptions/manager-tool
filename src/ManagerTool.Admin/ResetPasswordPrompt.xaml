<Window x:Class="ManagerTool.Admin.ResetPasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set a new password" Height="215" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1B1B1B">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Foreground="#EEE" FontSize="12.5" TextWrapping="Wrap" />
        <TextBlock Text="The password is shown in plain text so you can read it out." Foreground="#888"
                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

        <TextBox x:Name="PasswordBoxPlain" Height="28" VerticalContentAlignment="Center"
                 FontFamily="Consolas" FontSize="13" TextChanged="PasswordBoxPlain_TextChanged" />
        <TextBlock x:Name="Hint" Foreground="#C0392B" FontSize="11" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" />
            <Button x:Name="OkButton" Content="Set password" Height="28" Padding="14,0" Margin="8,0,0,0"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
